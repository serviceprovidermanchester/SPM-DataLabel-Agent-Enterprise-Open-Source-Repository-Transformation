# DataLabel Environment Configuration
# SPManchester Private Limited — AI Development Platform

# Server Port (default: 4000)
PORT=4000

# Server Host Binding (default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=development

# SQLite Database Storage File Path (default: ./datalabel.sqlite)
DB_PATH=datalabel.sqlite

# Optional Session & Token Secret Override
TOKEN_SECRET=spmanchester_datalabel_secure_secret_token_change_in_production
